# Ensure uniqueness against existing and between the new lists
unique_extra_swedish = []
for t in extra_swedish_stocks:
    if t not in existing_tickers and t not in unique_extra_swedish:
        unique_extra_swedish.append(t)

unique_extra_global = []
for t in extra_global_stocks:
    if t not in existing_tickers and t not in unique_extra_global:
        unique_extra_global.append(t)

all_new_tickers = {
    "Ytterligare Svenska Aktier (Ca 150 st)": unique_extra_swedish,
    "Ytterligare Globala Aktier (Ca 150 st)": unique_extra_global
}

import pprint

total_added = 0
filename = "/mnt/data/marketscan_config_update.py"

with open(filename, 'w', encoding='utf-8') as f:
    f.write("# =====================================================================\n")
    f.write("# MARKETSCAN - EXPORT FÖR CONFIG.PY (Totalt ~300 ytterligare aktier)\n")
    f.write("# =====================================================================\n")
    f.write("# Klistra in nedanstående listor i din config.py.\n")
    f.write("# Jag har sett till att det inte finns några dubbletter mot dina tidigare.\n")
    f.write("# Kom ihåg att lägga till listornas namn i UNIVERSE = list(...) längst ner.\n")
    f.write("# =====================================================================\n\n")

    for category, tickers in all_new_tickers.items():
        if tickers:
            f.write(f"# ════════════════ {category.upper()} ════════════════\n")
            list_name = "EXTRA_SVENSKA" if "Svenska" in category else "EXTRA_GLOBALA"
            f.write(f"{list_name} = [\n")
            
            for i in range(0, len(tickers), 8):
                chunk = tickers[i:i+8]
                line_items = ", ".join('"' + x + '"' for x in chunk)
                f.write(f"    {line_items},\n")
            f.write("]\n\n")
            total_added += len(tickers)

print(f"Success. Wrote {total_added} tickers to {filename}")
print(f"Swedish: {len(unique_extra_swedish)}, Global: {len(unique_extra_global)}")