# ============================================================
# MarketScan – Streamlit Secrets mall
# ============================================================
# Kopiera relevanta delar till Streamlit Cloud → Settings → Secrets
# OBS: Lägg ALDRIG in detta i .streamlit/secrets.toml utan döp
#      den filen till secrets.toml.local och lägg till i .gitignore
#
# Generera bcrypt-hash lokalt (streamlit-authenticator >= 0.3.x):
#   python -c "import streamlit_authenticator as stauth; print(stauth.Hasher.hash('dittlosenord'))"
# ============================================================

# ── Multi-user credentials ───────────────────────────────────
# Varje användare under [credentials.usernames.<användarnamn>]
# Användarnamnet 'admin' ger tillgång till Admin-sidan.

# OBS: Bara admin-kontot behöver vara här.
# Alla andra användare lägger du till via Admin-sidan i appen (👥 Användare-fliken).
[credentials.usernames.admin]
name     = "Admin"
email    = "admin@example.com"
password = "$2b$12$ERSÄTT_MED_RIKTIGT_BCRYPT_HASH"

# ── Cookie-inställningar ─────────────────────────────────────
# key: hemlig sträng (minst 32 tecken), generera t.ex. med:
#   python -c "import secrets; print(secrets.token_hex(32))"
[cookie]
name        = "marketscan_auth"
key         = "ERSÄTT_MED_EN_HEMLIG_STRÄNG_PA_MINST_32_TECKEN"
expiry_days = 30

# ── API-nycklar ──────────────────────────────────────────────
FINNHUB_API_KEY  = ""
DEEPSEEK_API_KEY = ""
GEMINI_API_KEY   = ""

# ── E-post ───────────────────────────────────────────────────
EMAIL_SENDER   = ""
EMAIL_PASSWORD = ""
EMAIL_TO       = ""

# ── GitHub-integration ───────────────────────────────────────
GITHUB_TOKEN = ""

# ── Scanner-lösenord (ej längre nödvändigt med multi-user auth) ──
# SITE_PASSWORD används nu INTE – behöver inte sättas.
# ADMIN_PASSWORD används nu INTE – behöver inte sättas.

# ── Watchlist (valfritt) ──────────────────────────────────────
# WATCHLIST_JSON = '[{"ticker": "VOLV-B.ST", "notes": ""}]'
