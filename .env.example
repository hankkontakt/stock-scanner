# ════════════════ MILJÖFIL-MALL ════════════════
# Detta är endast en mall — riktiga nycklar lagras i:
#   • GitHub Secrets (för CI/workflows)
#   • Streamlit Cloud Secrets (för deploy)
#   • Lokal .env (för utveckling — gitignored)
# Aldrig committa riktiga nycklar i denna fil.

FMP_API_KEY=din_fmp_nyckel_här
FINNHUB_API_KEY=din_finnhub_nyckel_här
DEEPSEEK_API_KEY=sk-your_deepseek_key_here
GEMINI_API_KEY=AIza_your_gemini_key_here
AI_PROVIDER=deepseek          # "deepseek" (komplex, kostar) eller "gemini" (enkel, gratis)
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3

# ════════════════ SITE-LÖSENORD ════════════════
# Kräver lösenord för att komma in på Streamlit-sidan.
# Sätt i Streamlit Cloud Secrets (SITE_PASSWORD) eller i .env för lokal utveckling.
# Lämna tomt för fri åtkomst (lokalt/test).
SITE_PASSWORD=

# ════════════════ MULTI-CHANNEL ALERTS ════════════════
# Telegram Bot — skapa via @BotFather på Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook — skapa i serverinställningar > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# Push-notifikationer via ntfy.sh (gratis, ingen API-nyckel)
# Välj ett unikt topic-namn: https://ntfy.sh/{topic}
NTFY_TOPY=

# SMS via email-to-SMS-gateways (använder EMAIL_SENDER + EMAIL_PASSWORD ovan)
# JSON-sträng med etikett->gateway-adress
# Exempel: {"telia":"46701234567@sms.telia.com","att":"15551234567@txt.att.net"}
SMS_GATEWAYS={}
